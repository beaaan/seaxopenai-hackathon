# Copy to .env (gitignored).
OPENAI_API_KEY=

# Backends per call kind: responses | appserver
LLM_BULK_BACKEND=responses
LLM_AGENT_BACKEND=appserver

# Concurrency and timeouts
PWT_RESPONSES_CONCURRENCY=16
PWT_APPSERVER_CONCURRENCY=10
PWT_TURN_TIMEOUT_MS=120000

# Override the codex executable (default: codex on PATH)
# PWT_CODEX_COMMAND=codex

PORT=8787
